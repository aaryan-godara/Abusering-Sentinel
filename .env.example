# Copy to `.env` and adjust locally. `.env` is git-ignored.

# Seed for all stochastic components. Keep at 42 for reproducible datasets.
RANDOM_SEED=42

# One of: development | testing | production
ENVIRONMENT=development

# Dataset root. Relative paths resolve against the project root.
DATA_DIRECTORY=data

# Frontend URL (for backend CORS configuration)
FRONTEND_URL=http://localhost:5173

# API Base URL (for frontend)
VITE_API_BASE_URL=http://127.0.0.1:8000
